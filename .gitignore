# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example
# .env.production.local is covered by .env* (production Apple Messages dry-run)

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# private imports (CSV uploads, Apple Messages reports, local overrides)
private-imports/
/apple-messages-overrides.json
/apple-messages-report.json
/apple-messages-report.csv

# local UTR Results Agent (browser profile, secret, logs)
.local/utr-browser-profile/
.local/utr-agent-secret
.local/utr-agent-cert.pem
.local/utr-agent-key.pem
.local/utr-agent-logs/
.local/isaac-utr-payload-sample.json
local-agents/utr-results-agent/node_modules/

# compiled Apple Messages helper (install-time output)
/helpers/apple-messages-sync/

# local Supabase CLI runtime (also ignored under supabase/.gitignore)
supabase/.temp/
