{
  "name": "denison-tennis-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "import:players": "tsx scripts/import-players.ts",
    "import:tournaments": "tsx scripts/import-tournaments.ts",
    "import:interactions": "tsx scripts/import-interactions.ts",
    "import:apple-messages": "tsx scripts/import-apple-messages.ts",
    "apple-messages-helper": "tsx scripts/apple-messages-helper.ts",
    "build:apple-messages-helper": "tsc -p tsconfig.apple-messages-helper.json",
    "verify:supabase": "tsx scripts/verify-supabase-connection.ts",
    "db:generate-seed": "tsx scripts/generate-supabase-seed.ts",
    "db:start": "supabase start && npm run db:seed-auth",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset && npm run db:seed-auth",
    "db:seed": "tsx scripts/apply-local-seed.ts",
    "db:seed:force-refresh": "tsx scripts/apply-local-seed.ts --force-refresh",
    "db:seed-auth": "tsx scripts/seed-local-auth.ts",
    "db:lint": "supabase db lint",
    "db:push": "supabase db push",
    "db:link": "supabase link",
    "db:env": "tsx scripts/print-local-supabase-env.ts",
    "test:export-engine": "tsx --test src/features/export-engine/*.test.ts",
    "test:hosted-auth-security": "tsx --test src/features/people/hostedAuthSecurity.migration.test.ts",
    "test:recruiting-coach-rank": "tsx --test src/features/recruiting/coachRank/*.test.ts",
    "test:recruiting": "tsx --test src/features/recruiting/analytics/*.test.ts src/features/recruiting/coachRank/*.test.ts src/features/recruiting/directoryInline.test.ts src/features/recruiting/rankViewSort.test.ts src/features/recruiting/metricsView.test.ts src/features/recruiting/visitDays.test.ts src/features/recruiting/visitDatePersist.test.ts src/features/recruiting/components/RecruitWorkspaceChrome.test.ts src/features/recruiting/components/RecruitingVisitWorkspace.test.ts src/features/recruiting/RecruitingWorkspaceLayout.guardrail.test.ts src/features/recruiting/dashboard.test.ts src/features/recruiting/changeLog/*.test.ts src/components/adaptive-workspace/fieldGrid.contract.test.ts src/components/nav-items.test.ts && playwright test tests/layout.cold-load.spec.ts tests/recruit-change-log.cold-load.spec.ts",
    "test:layout-cold-load": "playwright test tests/layout.cold-load.spec.ts",
    "test:tournaments": "tsx --test src/features/tournaments/*.test.ts",
    "test:interactions": "tsx --test src/features/interactions/*.test.ts src/features/interactions/components/*.test.ts src/features/interactions/appleMessagesSync/*.test.ts src/app/settings/*.test.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@next/env": "^16.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "csv-parse": "^7.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "supabase": "^2.111.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5"
  }
}
